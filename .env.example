# Variables de entorno para la practica 02
# Copiar este archivo a .env antes de levantar los contenedores (cp .env.example .env)

# Postgres
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_pass
POSTGRES_DB=todo_db

# Conexion desde la API hacia la base.
# OJO: dentro de la red de docker compose el host es el NOMBRE DEL SERVICIO ("db"),
# no "localhost". Si corres la API suelta (npm run dev, sin Docker) contra un
# Postgres local, cambia esto a localhost.
DB_HOST=db
DB_PORT=5432

# API
PORT=3001
